#: tmux_monitor.py:504
#, python-brace-format
msgctxt "dialog"
msgid ""
"End tmux session “{name}”?\n"
"All programs running in it will be terminated."
msgstr ""
"tmux-Sitzung „{name}“ beenden?\n"
"Alle darin laufenden Programme werden beendet."

#: tmux_monitor.py:515
msgctxt "status message"
msgid "No terminal found (set $TERMINAL)"
msgstr "Kein Terminal gefunden ($TERMINAL setzen)"

#: tmux_monitor.py:524
#, python-brace-format
msgctxt "status message"
msgid "Failed to start terminal: {error}"
msgstr "Terminal-Start fehlgeschlagen: {error}"

#: tmux_monitor.py:534
#, python-brace-format
msgctxt "footer"
msgid "Archive: {size} – compact?"
msgstr "Archiv: {size} – kompaktieren?"

#: tmux_monitor.py:549 tmux_monitor.py:645
msgctxt "dialog title"
msgid "Settings"
msgstr "Einstellungen"

#: tmux_monitor.py:554
msgctxt "settings"
msgid "Session archive"
msgstr "Sitzungsarchiv"

#: tmux_monitor.py:556
msgctxt "settings"
msgid "Archive the output of all tmux sessions"
msgstr "Ausgabe aller tmux-Sitzungen archivieren"

#: tmux_monitor.py:560
#, python-brace-format
msgctxt "settings"
msgid ""
"Adds one line to {conf} and applies it to the running tmux. Running sessions "
"are recorded from now on. The archive can contain everything shown in your "
"terminals."
msgstr ""
"Fügt eine Zeile in {conf} ein und wendet sie auf das laufende tmux an. "
"Laufende Sitzungen werden ab jetzt mitgeschrieben. Das Archiv kann alles "
"enthalten, was in deinen Terminals angezeigt wird."

#: tmux_monitor.py:569
msgctxt "settings"
msgid "Compact"
msgstr "Kompaktieren"

#: tmux_monitor.py:571
msgctxt "settings"
msgid "Clean and gzip the logs of ended sessions"
msgstr "Logs beendeter Sitzungen bereinigen und komprimieren"

#: tmux_monitor.py:573
msgctxt "settings"
msgid "Open folder"
msgstr "Ordner öffnen"

#: tmux_monitor.py:586
msgctxt "settings"
msgid "tmux-monitor-archive not found."
msgstr "tmux-monitor-archive nicht gefunden."

#: tmux_monitor.py:589
msgctxt "settings"
msgid "Start"
msgstr "Start"

#: tmux_monitor.py:591
msgctxt "settings"
msgid "Start at login"
msgstr "Bei der Anmeldung starten"

#: tmux_monitor.py:594
msgctxt "settings"
msgid "Always on top at startup"
msgstr "Beim Start immer im Vordergrund"

#: tmux_monitor.py:602
msgctxt "settings"
msgid "Language"
msgstr "Sprache"

#: tmux_monitor.py:606
msgctxt "settings"
msgid "System default"
msgstr "Systemvorgabe"

#: tmux_monitor.py:610
msgctxt "settings"
msgid "Restart now"
msgstr "Jetzt neu starten"

#: tmux_monitor.py:621
msgctxt "settings"
msgid "Installation"
msgstr "Installation"

#: tmux_monitor.py:626
#, python-brace-format
msgctxt "settings"
msgid "Installed version: {version}"
msgstr "Installierte Version: {version}"

#: tmux_monitor.py:627
msgctxt "settings"
msgid "Not installed as a package."
msgstr "Nicht als Paket installiert."

#: tmux_monitor.py:628
msgctxt "settings"
msgid "Install / update with yay"
msgstr "Mit yay installieren / aktualisieren"

#: tmux_monitor.py:630
msgctxt "settings"
msgid ""
"Builds the package from this folder in a tmux session and opens it in a "
"terminal (asks for your password)."
msgstr ""
"Baut das Paket aus diesem Ordner in einer tmux-Sitzung und öffnet sie in "
"einem Terminal (fragt nach deinem Passwort)."

#: tmux_monitor.py:662
#, python-brace-format
msgctxt "settings"
msgid ""
"Folder: {path}\n"
"{entries} entries ({active} active), raw {raw}, compacted {compacted}"
msgstr ""
"Ordner: {path}\n"
"{entries} Einträge ({active} aktiv), roh {raw}, kompaktiert {compacted}"

#: tmux_monitor.py:667
msgctxt "settings"
msgid "The archive is large – compacting is recommended."
msgstr "Das Archiv ist gross – Kompaktieren wird empfohlen."

#: tmux_monitor.py:675 tmux_monitor.py:689
msgctxt "dialog title"
msgid "Session archive"
msgstr "Sitzungsarchiv"

#: tmux_monitor.py:732
msgctxt "command line"
msgid "tmux session and GPU monitor (PyQt6)"
msgstr "tmux-Sitzungs- und GPU-Monitor (PyQt6)"

#: tmux_monitor.py:734
msgctxt "command line metavar"
msgid "SEC"
msgstr "SEK"

#: tmux_monitor.py:735
#, python-brace-format
msgctxt "command line"
msgid "refresh interval in seconds (default: {default})"
msgstr "Aktualisierungsintervall in Sekunden (Standard: {default})"

#: tmux_monitor.py:737
msgctxt "command line metavar"
msgid "LANG"
msgstr "SPRACHE"

#: tmux_monitor.py:738
msgctxt "command line"
msgid "UI language, e.g. de or en (default: Settings, else system locale)"
msgstr ""
"Sprache der Oberfläche, z. B. de oder en (Standard: Einstellungen, sonst "
"System-Locale)"

#: tmux_monitor.py:741
msgctxt "command line"
msgid "--interval must be greater than 0"
msgstr "--interval muss grösser als 0 sein"
